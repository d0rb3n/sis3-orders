{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StacksOfThisProject",
      "Effect": "Allow",
      "Action": "cloudformation:*",
      "Resource": "arn:aws:cloudformation:<REGION>:<ACCOUNT_ID>:stack/<STACK_PREFIX>-*/*"
    },
    {
      "Sid": "CfnReadAndTransform",
      "Effect": "Allow",
      "Action": ["cloudformation:ValidateTemplate", "cloudformation:GetTemplateSummary"],
      "Resource": "*"
    },
    {
      "Sid": "ProjectResources",
      "Effect": "Allow",
      "Action": [
        "ec2:*", "elasticloadbalancing:*", "ecs:*", "ecr:*", "logs:*",
        "sns:*", "sqs:*", "lambda:*", "dynamodb:*", "s3:*", "cloudwatch:*"
      ],
      "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "<REGION>" } }
    },
    {
      "Sid": "EcrLogin",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "RolesCreatedByStacks",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole", "iam:DeleteRole", "iam:GetRole", "iam:UpdateRole",
        "iam:TagRole", "iam:UntagRole",
        "iam:PutRolePolicy", "iam:DeleteRolePolicy", "iam:GetRolePolicy",
        "iam:AttachRolePolicy", "iam:DetachRolePolicy", "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies", "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/<STACK_PREFIX>-*"
    },
    {
      "Sid": "EcsServiceLinkedRole",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "*",
      "Condition": { "StringEquals": { "iam:AWSServiceName": ["ecs.amazonaws.com", "elasticloadbalancing.amazonaws.com"] } }
    },
    {
      "Sid": "Sts",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    }
  ]
}
